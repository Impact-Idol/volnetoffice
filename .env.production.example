# VolNetOffice Production Environment Configuration
# Copy this file to .env.production and fill in the values

# ============================================
# Instance Configuration
# ============================================
WEB_URL=https://your-domain.com
APP_DOMAIN=your-domain.com

# ============================================
# Security Keys (Generate unique values!)
# ============================================
# Generate with: openssl rand -hex 32
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

# ============================================
# Database Configuration
# ============================================
# For containerized PostgreSQL, use plane-db
# For external database, use your database host
PGHOST=plane-db
POSTGRES_PORT=5432
POSTGRES_DB=plane
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@plane-db:5432/plane

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@plane-redis:6379/

# ============================================
# RabbitMQ Configuration
# ============================================
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:YOUR_RABBITMQ_PASSWORD@plane-mq:5672/plane

# ============================================
# MinIO Storage Configuration
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
USE_MINIO=1
MINIO_ENDPOINT_SSL=0
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads

# ============================================
# SSO Integration (Optional)
# ============================================
# Uncomment and configure if using external SSO
# SSO_API_URL=https://your-sso-domain.com/api
# SSO_URL=https://your-sso-domain.com

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ============================================
# Application Settings
# ============================================
DEBUG=0
GUNICORN_WORKERS=2
API_KEY_RATE_LIMIT=60/minute
FILE_SIZE_LIMIT=52428800

# ============================================
# Port Configuration (for host machine)
# ============================================
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
